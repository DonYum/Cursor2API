# Copy to .env before running docker compose.
API_PORT=6718
ADMIN_PASSWORD=replace-with-a-strong-admin-password
PUBLIC_BASE_URL=
# One key may use CURSOR_API_KEY. Multiple keys may be comma/newline separated,
# label=key entries, or a JSON array of strings / {"label","key"} objects.
CURSOR_API_KEY=
CURSOR_API_KEYS=
CURSOR_SDK_BRIDGE_TOKEN=replace-with-a-long-random-token
CURSOR_SDK_BRIDGE_RUN_TIMEOUT_MS=180000
ENCRYPTION_KEY=replace-with-a-long-random-secret

# Leave these unset to build locally, or point them at prebuilt GHCR images.
# CURSOR2API_API_IMAGE=ghcr.io/nglsg/cursor2api-api:latest
# CURSOR2API_BRIDGE_IMAGE=ghcr.io/nglsg/cursor2api-bridge:latest
